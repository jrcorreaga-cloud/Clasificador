# Variables de entorno para RepOP Backend
# Copia este archivo como .env y completa los valores

# --- Base de datos ---
# MySQL (producción/Docker):
# DATABASE_URL=mysql+pymysql://republica_dev:Republica_2026!@db:3306/republicas_db
# SQLite (desarrollo local sin Docker, se usa automáticamente si no se define):
# DATABASE_URL=sqlite:///./repop.db

# --- Almacenamiento de imágenes ---
# 'local' guarda en backend/static/uploads/ (ideal para desarrollo)
# 's3'    sube a Amazon S3 (ideal para producción)
STORAGE_BACKEND=local

# --- Credenciales AWS S3 (solo necesarias si STORAGE_BACKEND=s3) ---
# AWS_ACCESS_KEY_ID=tu_access_key
# AWS_SECRET_ACCESS_KEY=tu_secret_key
# AWS_S3_BUCKET=nombre-de-tu-bucket
# AWS_REGION=us-east-1

# --- Seguridad JWT ---
# SECRET_KEY=cambia_esto_por_una_clave_segura
